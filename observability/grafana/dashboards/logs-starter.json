{
  "uid": "indramesh-logs",
  "title": "IndraMesh Logs (starter)",
  "description": "Minimal starter dashboard: log volume by category, errors by service, last task logs. Built only on the frozen low-cardinality labels (D-08).",
  "tags": ["indramesh", "logs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Log volume by category",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "indramesh-loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "indramesh-loki" },
          "expr": "sum by (category) (count_over_time({service=~\".+\"}[5m]))",
          "legendFormat": "{{category}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Errors by service",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "indramesh-loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "indramesh-loki" },
          "expr": "sum by (service) (count_over_time({level=\"error\"}[5m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Last task logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "indramesh-loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "indramesh-loki" },
          "expr": "{category=\"task\"}"
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "enableLogDetails": true
      }
    }
  ]
}
