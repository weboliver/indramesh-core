{
  "name": "frontend",
  "private": true,
  "version": "1.0.1",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:plugin-example": "npm ci --prefix ../plugins/example/frontend && npm run --prefix ../plugins/example/frontend build && node ../plugins/example/frontend/verify-bundle.mjs",
    "build:plugin-jira": "vite build --config ../plugins/jira/frontend/vite.config.mjs",
    "build:plugin-graphql-studio": "npm ci --prefix ../plugins/graphql-studio/frontend && npm run --prefix ../plugins/graphql-studio/frontend build && node ../plugins/graphql-studio/frontend/verify-bundle.mjs",
    "build:plugin-log-explorer": "npm ci --prefix ../plugins/log-explorer/frontend && npm run --prefix ../plugins/log-explorer/frontend build && node ../plugins/log-explorer/frontend/verify-bundle.mjs",
    "build:plugin-ai-schema-wizard": "vite build --config ../plugins/ai-schema-wizard/frontend/vite.config.mjs && node ../plugins/ai-schema-wizard/frontend/verify-bundle.mjs",
    "build:plugin-ai-translation": "vite build --config ../plugins/ai-translation/frontend/vite.config.mjs && node ../plugins/ai-translation/frontend/verify-bundle.mjs",
    "lint": "eslint . --max-warnings 0",
    "test:plugin-runtime": "node --test src/shared/plugin-runtime/loader.test.js src/shared/plugin-runtime/registry.test.js src/shared/plugin-runtime/contribution-utils.test.js src/shared/plugin-runtime/plugin-styles.test.js src/shared/plugin-runtime/deferred-module.test.js && eslint src/shared/plugin-runtime --max-warnings 0",
    "preview": "vite preview",
    "i18n:extract": "i18next-cli extract --sync-primary",
    "i18n:lint": "i18next-cli lint"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.0",
    "@tanstack/react-query": "^5.101.4",
    "@xyflow/react": "12.11.2",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "fuse.js": "^7.4.2",
    "graphql": "^16.9.0",
    "i18next": "26.3.6",
    "lucide-react": "1.28.0",
    "markdown-it": "^15.0.3",
    "react": "19.2.8",
    "react-colorful": "^5.7.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.11",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "esbuild": "^0.28.1",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "i18next-cli": "1.82.3",
    "knip": "^6.23.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
