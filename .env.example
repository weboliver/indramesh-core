# Database — DB_* is the single authored source of database credentials, used
# to construct DATABASE_URL at startup. Compose publishes DB_PORT (HOST port,
# default 5434) and overwrites DB_HOST/DB_PORT to postgres/5432 inside backend,
# worker and cutover. The postgres container's POSTGRES_* variables and the k8s
# Secret's POSTGRES_PASSWORD key are DERIVED from these, never authored in .env.
# Existing .env files: rename POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB to
# DB_USER/DB_PASSWORD/DB_NAME and POSTGRES_HOST_PORT to DB_PORT (same values);
# a leftover old block is ignored.
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
# Phase 311 (D-07): CHANGE_ME is a placeholder, never a working credential — the
# quickstart installer (./install_indramesh_docker.sh) replaces it with a
# generated secret before the stack starts. The previously shipped example
# passwords are publicly known defaults and must survive nowhere.
DB_PASSWORD=CHANGE_ME
DB_NAME=app

# Valkey (Phase 312.1, D-15/D-16) — the cache and queue service, named after the
# server that runs it. The URL scheme below stays `redis://` on purpose: that is the
# wire-protocol name, not a service name — only operator-visible names changed.
VALKEY_PASSWORD=CHANGE_ME
VALKEY_URL=redis://:${VALKEY_PASSWORD}@localhost:6379/0

# OpenSearch (Phase 312.1, D-01/D-02/D-03/D-05)
# The backend and worker connect as this admin user; the container's demo security
# configuration enforces Basic Auth on the loopback-published listener.
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USERNAME=admin
# The password rule the image's demo-configuration installer enforces at first start:
# 8-100 characters with at least one uppercase, one lowercase, one digit and one special
# character, and not similar to the user name. The quickstart installer generates a
# compliant value (scripts/lib/secrets.sh) — a non-compliant value (for example a
# carried-over hex password) makes the container exit at start and is refused by the
# installer's fail-closed gate.
OPENSEARCH_PASSWORD=CHANGE_ME

# Jira
# Phase 296 (CLEAN-05, D-05): the former Core sync engine was removed and the
# Jira plugin reads its own per-connection URL, so no Core service consumes
# JIRA_URL. Phase 311 (OQ-5): the dev-only docker-compose.jira.yml supplies it
# (with a working default) for the development stack — it deliberately stays out
# of this public quickstart example.

# Backend
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=5173

# Phase 81 — Security Headers / Phase 311 (D-01)
# Phase 311 (D-01): the shipped default is the production shape the public
# quickstart runs — Uvicorn without --reload and the frontend served through
# `vite preview` from the bundle baked into /srv/frontend-dist (no source bind
# mounts, code taken from the image). Set ENVIRONMENT=development to switch back
# to the developer workflow with hot reload; that needs the mirrored dev overlay
# docker-compose.dev.yml layered on top (see docs/DEVELOPMENT.md).
ENVIRONMENT=production

# Phase 298 — Structured Logging (LOG-02, D-15)
# LOG_FORMAT selects the rendered log shape for every IndraMesh process
# (backend, worker, storage, plugin runner, cutover). Allowed values:
#   json    — one JSON object per line (production/Loki-friendly)
#   logfmt  — key=value pairs
#   console — human-readable, colored
# Leave EMPTY to derive the default from ENVIRONMENT: console when
# ENVIRONMENT=development, json when ENVIRONMENT=production. The explicit
# per-service propagation in docker-compose.yml means a shell-selected value is
# not masked by this file. Changing it requires recreating backend, worker and
# storage from the MAIN checkout (never from a git worktree):
#   ./rebuild_indramesh_docker.sh backend worker storage
# LOG_FORMAT=

# Phase 299 — Runtime log levels (LVL-01, D-17)
# LOG_LEVEL is the global env basis applied by every process that calls
# configure_logging (backend, worker, storage, cutover). LOG_LEVELS is a
# comma-separated per-category basis, e.g. connector.jira=DEBUG,db=WARNING.
# Both are intentionally EMPTY by default: a missing/empty value preserves the
# Foundation noisy-logger defaults and normal logger inheritance (D-17). Do NOT
# set an INFO default here — that would silence those defaults. Runtime
# overrides are issued through GET/PUT /api/v1/logging/levels and expire on
# their own; they do not need a container restart.
# LOG_LEVEL=
# LOG_LEVELS=

# Phase 300 — Core task log cap and retention (D-12/TLOG-05)
# TASK_LOG_MAX_LINES caps the stored lines per task run: the first half and the
# last half are kept, the discarded middle is marked "N lines dropped". Default
# 10000, allowed 2..10000. TASK_LOG_RETENTION_DAYS is the retention window in
# days; the worker purges older lines hourly without deleting the Task row and
# never touches PENDING/RUNNING tasks. Default 30, allowed 1..3650. Changing
# either requires recreating backend AND worker from the MAIN checkout:
#   ./rebuild_indramesh_docker.sh backend worker
# TASK_LOG_MAX_LINES=
# TASK_LOG_RETENTION_DAYS=

# Phase 301 — Log infrastructure (LOGINFRA-01..05, D-01..D-07)
# Phase 311 (D-16): the whole log stack — Loki, Alloy and docker-socket-proxy —
# sits behind the `[logging, observability]` profiles and Grafana behind
# `observability`, so it does not run with the default quickstart. Activate it
# with the `logging` profile (set COMPOSE_PROFILES=logging in your root .env, or
# pass `--profile logging`) and inspect it with `docker compose logs alloy`.
# Every key below is optional and shows its shipped default. See
# docs/LOGGING-INFRASTRUCTURE.md for the full operator manual (tee semantics,
# retention, rotation, RAM methodology).
#
# ALLOY_SINK selects the checked-in Alloy sink fragment: loki | otlp | otlphttp
# | none. A typo makes `cat` fail so Alloy never starts (visible restart loop in
# `docker compose logs alloy`). otlp/otlphttp are TEE sinks: the bundled Loki
# keeps receiving while it is running.
# ALLOY_SINK=loki
#
# OTLP_ENDPOINT is the external OTLP intake. gRPC wants host:port (e.g.
# graylog:4317); HTTP is a full base URL and defaults its path to /v1/logs.
# OTLP_AUTHORIZATION is the Authorization header value (HTTP/otlphttp only —
# plaintext gRPC cannot carry credentials; send pre-encoded Basic).
# OTLP_TLS_INSECURE defaults to false = TLS in BOTH Compose and k8s; only the
# explicit value `true` enables plaintext gRPC.
# OTLP_ENDPOINT=
# OTLP_AUTHORIZATION=
# OTLP_TLS_INSECURE=false
#
# LOKI_URL is the bundled loki.write push endpoint.
# LOKI_QUERY_URL is the Loki query base the log-explorer plugin reads for
# server-side LogQL queries — a bare http(s) base WITHOUT the /loki/api/v1
# path; Compose default http://loki:3100, k8s default
# http://loki.monitoring.svc.cluster.local:3100. A new value takes effect on
# the next backend (re)creation.
# LOKI_RETENTION_PERIOD is the Loki retention window (default 14 days = 336h).
# LOGINFRA_ENABLED gates the whole k8s log stack. It is an uncommented,
# REQUIRED key defaulting to false — see the k3s component-switch block at the
# end of this section.
#
# External sink (Phase 311/OQ-1): the retired Compose deploy-replicas off-switch
# is gone and profile activation replaces it. To ship to an operator-owned Loki
# instead of the bundled one, activate the `logging` profile, point
# LOKI_QUERY_URL at the external Loki and set LOG_EXPLORER_EXTERNAL_ONLY=true.
# LOG_EXPLORER_EXTERNAL_ONLY declares "server logs go only to the external sink";
# it is never inferred from unreachability.
# GRAFANA_EXPLORE_URL / GRAFANA_LOKI_DATASOURCE enable the "open in Grafana"
# deep link: the browser-reachable Grafana base and the Loki datasource UID;
# empty = no link (the optional Compose Grafana is never linked by default).
# LOKI_URL=http://loki:3100/loki/api/v1/push
# LOKI_QUERY_URL=http://loki:3100
# LOKI_RETENTION_PERIOD=336h
# LOG_EXPLORER_EXTERNAL_ONLY=false
# GRAFANA_EXPLORE_URL=
# GRAFANA_LOKI_DATASOURCE=

# Phase 311.1 (D-06, D-09) — k3s quickstart component switches.
# The Kubernetes quickstart is LEAN by default: ./install_indramesh_k8s.sh
# installs Core, the stateful services and cert-manager/PKI (TLS stays
# mandatory), and nothing else. The monitoring stack (kube-prometheus-stack),
# Headlamp and the log stack (Loki + Alloy) are opt-in through the three
# switches below. This mirrors the Compose `logging`/`observability` profiles
# above — same operator intent (opt in to the heavy stacks), different mechanism
# per platform.
#
# Each switch is read by the KUBERNETES installer only, and each is an
# UNCOMMENTED, REQUIRED key: a copy of this file is that installer's schema, so
# every assignment here must exist in your .env. A component is installed only
# when its switch is the EXACT string `true`; any other value — including empty
# — means off. The installer then skips the whole component: its Helm release
# and, for monitoring, the Grafana credential check; for Headlamp, the image
# acquisition.
#
# A switched-off run is never a cleanup: it simply stops managing the component.
# A kube-prometheus-stack, Loki or Alloy release that is already installed keeps
# running, unmanaged (D-09). What a switched-off run DOES prune is only the
# IndraMesh chart's own component-gated objects — the ServiceMonitor, the
# dashboard ConfigMap, the monitoring NetworkPolicy clauses and the nginx
# `/grafana/` front door, plus the chart-owned Headlamp Deployment/RBAC. Those
# are the chart reconciling its own resources on the next full Helm pass, not
# the installer deleting a release.
#
# Upgrading an existing private .env (D-09): add these three lines by hand. An
# uncommented assignment here is a required key for the Kubernetes installer, so
# a .env that lacks them fails the schema gate naming the missing key.
MONITORING_ENABLED=false
HEADLAMP_ENABLED=false
LOGINFRA_ENABLED=false

# Phase 287.1 — Plugin migration role (PLUGDB-07)
# The plugin migration runner executes each plugin revision as a dedicated,
# non-owner PostgreSQL role that owns no Core table and holds only
# SELECT + REFERENCES on Core tables, so a plugin revision cannot DROP/ALTER/
# DELETE Core data. The role is bootstrapped on every deploy, between the Core
# migration and the plugin runner. See docs/CONFIGURATION.md.
#
# PLUGIN_DB_USER is the role name (NOT a secret). Any valid, safe PostgreSQL
# identifier is accepted; when it is empty or unset the name defaults to
# indramesh_plugin.
# PLUGIN_DB_PASSWORD is the role password (a secret — rotate it deliberately).
#
# Credential matrix:
#   both empty/unset         -> weakened fallback: the runner keeps the
#                               privileged application connection and logs one
#                               prominent WARNING that Core tables are
#                               unprotected from plugin revisions.
#   password set, user empty -> valid; the role name defaults to
#                               indramesh_plugin.
#   user set, password empty -> FATAL misconfiguration; the deploy aborts
#                               before any revision runs.
#   configured but bootstrap/GRANT fails (or privilege drift is detected)
#                            -> FATAL; there is no silent drop to the
#                               privileged connection.
#
# The example below activates the boundary for a local dev stack and uses the
# documented default role name (indramesh_plugin); set a different valid
# PostgreSQL identifier to override it. Phase 311 (D-07): the password carries
# the CHANGE_ME placeholder and the installer generates the real value — the
# operator owns rotation afterwards (change the value and re-run the deploy, and
# the bootstrap reconciles the role password).
PLUGIN_DB_USER=indramesh_plugin
PLUGIN_DB_PASSWORD=CHANGE_ME

# Phase 275 — Compose Production-Mode Support (COMPOSE-PROD-01/02)
# production (the shipped default above) is the public quickstart's shape:
# Uvicorn without --reload after `alembic upgrade head`, and the image-time
# built static bundle at /srv/frontend-dist (outside the ./frontend:/app bind
# mount) served through Vite preview on port 5173. The exact value
# ENVIRONMENT=development selects the developer workflow instead — Uvicorn with
# --reload and the bind-mounted Vite dev server with HMR, which needs the
# docker-compose.dev.yml overlay; a missing or unknown value behaves like
# development. The ARQ worker is unchanged in every mode.
#
# After changing ENVIRONMENT, rebuild/recreate the affected services through
# the existing Compose dispatcher (no profile, service, or Kubernetes action):
#   ./rebuild_indramesh_docker.sh backend
#   ./rebuild_indramesh_docker.sh frontend

# Testing — full-suite guard (see AGENTS.md "Testing Strategy")
# INDRAMESH_ALLOW_FULL_SUITE=1 unlocks a bare `pytest` run (~1200 tests) in
# backend/tests/conftest.py. Do NOT set this here permanently — it defeats the
# guard's purpose. Pass it inline only, for the Regression phase:
#   INDRAMESH_ALLOW_FULL_SUITE=1 pytest

# Phase 82 — Rate Limiting
# RATE_LIMIT_ENABLED defaults to false for the shared dev/test stack.
# The same docker-compose stack runs backend tests + E2E — with rate limiting
# enabled those suites would hit 429s under sustained load.  A real deployment
# MUST override this to true.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_GLOBAL=200/minute
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_FALLBACK=50/minute
# D-10 — per-token rate limit for the public realm (/public/api/v1)
PUBLIC_API_RATE_LIMIT=200/minute
# NGINX_TRUSTED_IP must match the static ipv4_address assigned to nginx in
# docker-compose.yml (see T3.2). The same variable feeds the backend's
# trusted-proxy list and nginx's static address, so the two can never drift.
NGINX_TRUSTED_IP=172.28.0.10

# Phase 311 (D-15) — Compose-only network identity. All three values have
# Compose-side defaults, so they are COMMENTED examples: every uncommented assignment in this
# file becomes a required key for a k3s install (scripts/k8s/install.sh validates
# the operator's .env against this file as its schema — see
# scripts/k8s/lib/common.sh). Uncomment only to override — e.g. VALKEY_PORT /
# OPENSEARCH_PORT when the loopback port is already taken. COMPOSE_SUBNET is
# handled by ./install_indramesh_docker.sh: when the default range is already in
# use it writes a free one here, together with a matching NGINX_TRUSTED_IP.
# COMPOSE_SUBNET=172.28.0.0/16
# VALKEY_PORT=6379
# OPENSEARCH_PORT=9200

# Phase 80 — Secrets Management / Phase 311 (D-07)
# Both keys are REQUIRED (docker-compose.yml guards them with ${VAR:?…}) and
# carry the CHANGE_ME placeholder so that a copy of this file renders the whole
# project. The quickstart installer (./install_indramesh_docker.sh) replaces the
# placeholder with a generated value before the stack starts — never ship
# CHANGE_ME. They must also be filled before a k3s install: every uncommented
# assignment here is a required key for scripts/k8s/install.sh, and the k3s path
# puts JWT_SECRET_KEY and FERNET_KEY into the indramesh-backend-auth Secret.
#
# FERNET_KEY: Fernet symmetric encryption key for ServiceAccount bearer tokens.
# Generate (route used by the installer — the project's own image, so no host
# Python dependency): `docker compose build backend` then
#   docker compose run --rm --no-deps --entrypoint python backend \
#     -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=CHANGE_ME

# FERNET_KEY_OLD (optional, SEC313-69): the PREVIOUS FERNET_KEY, set only while
# a key rotation is running. When present, new writes use FERNET_KEY while values
# encrypted under FERNET_KEY_OLD are still readable (backend/worker build a
# MultiFernet from both); leave it unset/empty at all other times. An invalid
# value aborts startup rather than silently dropping the old key. Finish the
# rotation with `python -m app.maintenance rotate-fernet-key` (dry run first:
# `rotate-fernet-key --check`) and delete this line — and the key from the
# indramesh-backend-auth Secret in a k3s install — only after it exits 0 with
# "FERNET_KEY_OLD can be removed". Then recreate the backend and worker
# (`docker compose up -d backend worker`, because `docker compose restart` does
# not re-read this file) — from that point the old ciphertext is unreadable.
# Step by step for Compose and k3s: docs/DEPLOYMENT.md, "Fernet Key Rotation".
# FERNET_KEY_OLD=

# JWT_SECRET_KEY: Secret key for JWT token signing (HS256).
JWT_SECRET_KEY=CHANGE_ME

# ADMIN_PASSWORD (Phase 311, D-08/D-09): the initial admin password. It is used
# ONLY when the admin user is first created on a fresh database. Changing it in
# .env later has NO effect — the password is changed in the UI; there is no
# sync-on-start code. The backend fails closed (in every runtime mode) when this
# is missing or empty. The installer fills it with a generated value and prints
# it only on the run that generated it.
ADMIN_PASSWORD=CHANGE_ME

# Phase 302 (LLM-02, D-01..D-04) — provider-neutral LLM config (read by app/llm)
# LLM_PROVIDER selects a preset that supplies a default base URL and structured
# mode: mistral | openai | openai_compatible. openai_compatible requires an
# explicit LLM_BASE_URL. An explicit LLM_BASE_URL/LLM_MODE always wins.
# LLM_MODEL is a bare model id (e.g. mistral-small-latest) — a legacy mistral/
# prefix is rejected loudly, never silently split.
# LLM_BASE_URL must include the /v1 suffix (the OpenAI-compatible base that
# /chat/completions is appended to); the host-only form 404s.
# LLM_MODE overrides the provider default: tools | json_schema | json | md_json;
# leave blank to use the preset default (mistral -> json_schema, openai -> tools).
# LLM_API_KEY=
# LLM_PROVIDER=
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_MODE=

# K8S_EGRESS_ALLOW (Kubernetes only, Phase 318): extra outbound targets for the
# backend and worker, as comma-separated IP[/len]:port entries — for example an
# on-prem Jira Data Center at 10.0.5.20/32:8080. Public addresses on port 443
# (Jira Cloud, the hosted LLM presets) are admitted without an entry; a private
# LLM_BASE_URL host is added by the installer itself. See docs/CONFIGURATION.md.
# K8S_EGRESS_ALLOW=

# Phase 99 — JWT & Session Security
# MAX_TOKEN_AGE_SECONDS: Optional token age limit (seconds). If set, tokens older than this value are rejected.
# Leave unset (or comment out) to skip age validation and rely only on exp claim (backward compatible).
# Example: MAX_TOKEN_AGE_SECONDS=3600 (1 hour max age)
# MAX_TOKEN_AGE_SECONDS=

# CLOCK_SKEW_TOLERANCE_SECONDS: Clock skew tolerance for nbf (not-before) claim validation (seconds).
# Default: 10 seconds. Allows minor clock differences in distributed systems. Set to 0 for strict validation.
# Example: CLOCK_SKEW_TOLERANCE_SECONDS=10
# CLOCK_SKEW_TOLERANCE_SECONDS=10

# Phase 183 -- GraphQL Production Hardening
# Controls maximum query depth for self-referential types (ObjectType.parent/children)
GRAPHQL_MAX_DEPTH=15
# GraphQL cost & execution limits (Phase 312). These apply identically to
# /api/v1/graphql, /public/api/v1/graphql and the saved-query execution path;
# there is deliberately no switch to disable the limits (D-11). Changed values
# require a backend restart — AppSettings is built once at import.
# GRAPHQL_MAX_TOKENS: maximum document size in tokens (the parser aborts above it).
GRAPHQL_MAX_TOKENS=2000
# GRAPHQL_MAX_ALIASES: maximum number of aliases in one document (amplification guard).
GRAPHQL_MAX_ALIASES=20
# GRAPHQL_MAX_COST: cost budget for one operation (nested list fields are weighted).
GRAPHQL_MAX_COST=20000
# GRAPHQL_NESTED_LIST_LIMIT: per-parent hard cap for nested list fields.
GRAPHQL_NESTED_LIST_LIMIT=500
# GRAPHQL_STATEMENT_TIMEOUT: Postgres statement_timeout in MILLISECONDS.
GRAPHQL_STATEMENT_TIMEOUT=5000
# GRAPHQL_EXECUTION_TIMEOUT: wall-clock backstop in SECONDS. Must exceed the
# statement timeout — an invalid pairing is rejected at startup, never started
# silently; both stay under nginx's 60 s read timeout. The OpenSearch search
# read bound is half this value, capped at 5 s.
GRAPHQL_EXECUTION_TIMEOUT=10.0

# Phase 95 — Transport & Network Security
# HTTPS_PORT is the host port mapped to Nginx's 443 listener. It defaults to
# 8443 (docker-compose.yml maps "${HTTPS_PORT:-8443}"); uncomment to override,
# e.g. when 8443 is already taken on the host.
# HTTPS_PORT=8443
# TLS_CERT_DIR is the host directory mounted into the Nginx container.
# For production, override this to point at your real cert location
# (e.g. /etc/letsencrypt/live/yourdomain.com) and remove the self-signed
# cert from nginx/certs/ in your deployment artifact.
# TLS_CERT_DIR=./nginx/certs
# CORS_ALLOWED_ORIGINS (Phase 311, D-07): comma-separated list of trusted browser
# origins. Required — the backend validates it at import time and refuses to
# start without it. The shipped value covers the quickstart and the dev stack:
# the direct Vite frontend, nginx over https, and nginx over http.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://localhost:8443,http://localhost:8180
