# stateful-image-digests.env — measured k3s import evidence for the three
# stateful wrapper images (Phase 256 gate, re-measured in Phase 312.1).
#
# The values below are produced ONLY by a real import on a k3s host:
#     sudo scripts/k8s/verify_stateful_services.sh --import <this file>
# which measures the containerd target digest before and after the import and
# rewrites this file. Never hand-edit a digest — `assert_image_evidence_current`
# compares these values against containerd, and a hand-filled value would make
# that check pass for the wrong reason.
#
# STALE AFTER A WRAPPER REBUILD: Phase 323 changed both wrappers (postgres lost
# /usr/local/bin/gosu, valkey moved into Compose) and raised both refs to -r1,
# so the digest columns below still describe the previous -r0 build. That is
# deliberate rather than guessed: the live gate fails closed on its first check
# until the next `--import` re-measures and rewrites this file. The re-measure
# is the deferred k3s step (deferred: milestone-regression), not a silent pass.
POSTGRES_IMAGE_REF=docker.io/library/indramesh-stateful-postgres:18.4-age1.8.0-pgv0.8.7-r1
POSTGRES_PRE_IMPORT_TARGET_DIGEST=sha256:34ef46f89e41d605ea6eddb438dbdbdf4c5ad9bf11f40b8a2a972dae654242ca
POSTGRES_POST_IMPORT_TARGET_DIGEST=sha256:34ef46f89e41d605ea6eddb438dbdbdf4c5ad9bf11f40b8a2a972dae654242ca
VALKEY_IMAGE_REF=docker.io/library/indramesh-stateful-valkey:9.1.1-r1
VALKEY_PRE_IMPORT_TARGET_DIGEST=sha256:d2e7075c7117a4edb24a0633eb53c907e1b16707428179d6de6713eb003090c2
VALKEY_POST_IMPORT_TARGET_DIGEST=sha256:d2e7075c7117a4edb24a0633eb53c907e1b16707428179d6de6713eb003090c2
OPENSEARCH_IMAGE_REF=docker.io/library/indramesh-stateful-opensearch:3.9.0-r1
OPENSEARCH_PRE_IMPORT_TARGET_DIGEST=sha256:50adc4f18472517ec396fe0374651ec5bf59c1bd098a96598a04405a5e34c8a3
OPENSEARCH_POST_IMPORT_TARGET_DIGEST=sha256:50adc4f18472517ec396fe0374651ec5bf59c1bd098a96598a04405a5e34c8a3
