# versions.env — non-secret pinned k3s/Helm versions and bootstrap defaults for
# the Phase 254 k3s bootstrap (D-10, D-12, D-21). Repository-owned; deliberately
# small so only non-secret pins and defaults live here (T-254-02). Pins change
# only through a reviewed repository update — never a moving channel (D-10).
#
# Supported architectures (D-13): amd64 and arm64.
#   k3s upstream server-binary assets: amd64 -> "k3s", arm64 -> "k3s-arm64"
#   Helm upstream archive assets:     helm-<HELM_VERSION>-linux-<arch>.tar.gz
# The scripts/k8s/lib/artifacts.sh library maps PLATFORM_ARCH to these assets.
#
# Maintenance note: updating a pin requires re-fetching the matching official
# SHA-256 from its cited source (tagged install.sh, sha256sum-<arch>.txt, or
# .tar.gz.sha256sum) and updating checksums.sha256 in the same reviewed commit.
K3S_VERSION=v1.36.4+k3s1
HELM_VERSION=v4.2.4

# Phase 259 (NET-03, D-07): pinned cert-manager operator + official signing
# keyring. Non-secret. The keyring is fetched from CERT_MANAGER_KEYRING_URL,
# SHA-256-verified against checksums.sha256 (staged filename MUST equal
# CERT_MANAGER_KEYRING_FILE so `sha256sum -c` resolves it), and passed to
# `helm --verify` — never a PATH Helm, never a moving tag (T-259-05).
CERT_MANAGER_VERSION=v1.21.1
CERT_MANAGER_KEYRING_URL=https://cert-manager.io/public-keys/cert-manager-keyring-2021-09-20-1020CF3C033D4F35BAE1C19E1226061C665DF13E.gpg
CERT_MANAGER_KEYRING_FILE=cert-manager-keyring.gpg

# Phase 261 (MON-01, D-07): pinned kube-prometheus-stack + official signing
# keyring. Non-secret. KUBE_PROMETHEUS_STACK_CHART is an OCI reference — it
# resolves directly as the positional `helm upgrade --install` chart argument,
# exactly like CERT_MANAGER_CHART (oci://quay.io/jetstack/charts/cert-manager);
# a classic HTTPS index-repo URL is NOT a valid bare positional chart argument
# (it would need a --repo flag or a prior `helm repo add`, no precedent here).
# The keyring is fetched from PROMETHEUS_COMMUNITY_KEYRING_URL, SHA-256-verified
# against checksums.sha256 (staged filename MUST equal
# PROMETHEUS_COMMUNITY_KEYRING_FILE so `sha256sum -c` resolves it), and passed
# to `helm --verify` — never a PATH Helm, never a moving tag (T-261-SC).
KUBE_PROMETHEUS_STACK_VERSION=88.6.2
KUBE_PROMETHEUS_STACK_CHART=oci://ghcr.io/prometheus-community/charts/kube-prometheus-stack
PROMETHEUS_COMMUNITY_KEYRING_URL=https://prometheus-community.github.io/helm-charts/pubkey.gpg
PROMETHEUS_COMMUNITY_KEYRING_FILE=prometheus-community-pubkey.gpg

# Phase 262 (UI-K8S-01, D-02): pinned Headlamp image. Non-secret — the pin is
# an upstream container image reference, changed only through a reviewed
# commit (T-254-02). No checksums.sha256 entry is needed for this pin: the
# monitoring precedent above verifies a Helm *chart keyring*, not container
# images — the Headlamp image digest is instead recorded at import time when
# install.sh imports it into containerd (IMG-02 contract), not verified
# against a committed checksum manifest.
#
# Edit-Pair contract: HEADLAMP_VERSION is the Edit-Pair half to
# headlamp.image.tag in deploy/helm/indramesh/values.yaml — both change ONLY
# together in a single reviewed commit. Drift between the two fails the
# cross-consistency assertion in tests/bootstrap/test_artifacts.sh (Plan
# 262-02 Task 1), at pin/render time, never as a live ImagePullBackOff.
HEADLAMP_VERSION=v0.45.0
HEADLAMP_IMAGE=ghcr.io/headlamp-k8s/headlamp

# Phase 301 (LOGINFRA-03, D-11): pinned Loki community chart + official
# grafana-community signing keyring. Non-secret. LOKI_CHART is an OCI reference
# (oci://ghcr.io/grafana-community/helm-charts/loki) that resolves directly as
# the positional `helm upgrade --install` chart argument, exactly like
# CERT_MANAGER_CHART and KUBE_PROMETHEUS_STACK_CHART. The chart release is
# signed (.prov asset + OCI provenance layer), so the D-11 verified path uses
# `helm --verify` against this keyring — the keyring is fetched from
# GRAFANA_COMMUNITY_KEYRING_URL, SHA-256-verified against checksums.sha256
# (staged filename MUST equal GRAFANA_COMMUNITY_KEYRING_FILE so `sha256sum -c`
# resolves it), and dearmored before `--keyring` (261-05 pattern). Pins change
# only through a reviewed repository update — never a moving channel (D-10).
LOKI_CHART_VERSION=18.13.8
LOKI_CHART=oci://ghcr.io/grafana-community/helm-charts/loki
GRAFANA_COMMUNITY_KEYRING_URL=https://grafana-community.github.io/helm-charts/pubkey.gpg
GRAFANA_COMMUNITY_KEYRING_FILE=grafana-community-pubkey.gpg

# Phase 301 (LOGINFRA-03, D-11): pinned Grafana Alloy Helm chart (non-secret).
# Unlike the signed Loki/cert-manager/kube-prometheus-stack charts above, this
# chart ships NO provenance asset (.prov), so `helm --verify` / OCI provenance
# is impossible here. D-11 therefore makes the SHA-256-pinned local tgz the
# PRIMARY verified path, not a fallback: ALLOY_CHART_URL is downloaded to
# ALLOY_CHART_FILE inside the installer's private staging dir and its digest is
# checked against checksums.sha256 BEFORE any helm invocation (T-301-12). OCI
# --verify and a moving tag are both forbidden for this chart (D-10). Pins
# change only through a reviewed repository update — never a moving channel.
ALLOY_CHART_VERSION=1.13.0
ALLOY_CHART_URL=https://github.com/grafana/helm-charts/releases/download/alloy-1.13.0/alloy-1.13.0.tgz
ALLOY_CHART_FILE=alloy-1.13.0.tgz

# Bootstrap defaults per D-21 (canonical chart path + release identity).
HELM_CHART_PATH=deploy/helm/indramesh
HELM_RELEASE_NAME=indramesh